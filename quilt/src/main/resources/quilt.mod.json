{
  "schema_version": 1,
  "mixin": [
    "shaper.mixins.json",
    "shaper-common.mixins.json"
  ],
  "quilt_loader": {
    "group": "${group}",
    "id": "shaper",
    "version": "${version}",
    "metadata": {
      "name": "Shaper",
      "description": "",
      "contributors": {
        "Vowxky": "Owner"
      },
      "contact": {
        "sources": "https://github.com/architectury/architectury-templates"
      },
      "icon": "assets/examplemod/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "net.shaper.quilt.ShaperModQuilt"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "version": "*"
      },
      {
        "id": "quilt_base",
        "version": "*"
      },
      {
        "id": "minecraft",
        "version": ">=1.20.1"
      },
      {
        "id": "architectury",
        "version": ">=9.1.12"
      }
    ]
  },
  "minecraft": {
    "environment": "*"
  }
}